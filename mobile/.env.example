# Copy to mobile/.env.local (git-ignored) and fill in, then restart Expo
# with `npx expo start -c` so the value is picked up.

# Must match YOMAN_API_KEY on the backend (Railway service variables).
# For EAS cloud builds, add it as an EAS environment variable too:
# .env.local isn't uploaded with the project.
EXPO_PUBLIC_YOMAN_API_KEY=
