# Copy to .env (backend root) and fill in. Never commit .env.
# These are placeholders for Weekend 3+; not used yet in Weekend 1.

# OpenAI — Whisper transcription + embeddings (Weekend 3, 7)
OPENAI_API_KEY=

# Anthropic — Claude entry structuring (Weekend 4)
ANTHROPIC_API_KEY=
# Optional overrides. Defaults: claude-sonnet-5-5, 4096, between_tools, low.
# claude-sonnet-4-5 retires 2026-11-30, so don't pin it here or on Railway.
# ANTHROPIC_MODEL=
# ANTHROPIC_MAX_TOKENS=
# ANTHROPIC_THINKING=
# ANTHROPIC_EFFORT=

# Shared app key the mobile app sends as X-Yoman-Key (temporary lock until
# Supabase Auth). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Put the same value in mobile/.env.local as EXPO_PUBLIC_YOMAN_API_KEY.
YOMAN_API_KEY=

# Supabase — Auth + managed Postgres (Weekend 8)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=
